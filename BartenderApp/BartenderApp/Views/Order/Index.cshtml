@model IEnumerable<BartenderApp.Models.Drink>

@{
    ViewData["Title"] = "Menu";
}

<h1>Menu</h1>

<div style="position: fixed; top: 20px; right: 20px; border: 1px solid #ddd; border-radius: 12px; padding: 20px; background: white; min-width: 200px; display: flex; flex-direction: column; gap: 10px; box-shadow: 0 2px 12px rgba(0,0,0,0.1);">
    <div style="font-family: 'Inter', sans-serif; font-size: 13px; color: #666;">Items: <span id="order-items">0</span></div>
    <div style="font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 500;">Total: <span id="order-total">$0.00</span></div>
    <a asp-controller="Order" asp-action="" style="text-align: center; padding: 10px; border: 1px solid #333; border-radius: 8px; text-decoration: none; color: #333; font-family: 'Inter', sans-serif; font-size: 13px;">Place Order</a>
    <button class="alert-danger" onclick="clearCart()" style="padding: 10px; border: 1px solid #ddd; border-radius: 8px; background: none; color: darkred; font-family: 'Inter', sans-serif; font-size: 13px; cursor: pointer;">Clear Cart</button>
</div>

<table>
    
    <tbody>
    @foreach (var drink in Model)
    {
        <div class="drink-card" data-price="@drink.Price">
            <div class="drink-name">@drink.Name</div>
            <div class="drink-desc">@drink.Description</div>
            <div class="drink-footer">
                <span class="drink-price">$@drink.Price.ToString("0.00")</span>
                <div class="drink-qty">
                    <button onclick="changeQty(this, -1)"><i class="bi bi-dash-circle"></i></button>
                    <span class="qty">0</span>
                    <button onclick="changeQty(this, 1)"><i class="bi bi-plus-circle"></i></button>
                </div>
            </div>
        </div>
    }
    </tbody>
</table>

<script>
    function changeQty(btn, delta) {
        const card = btn.closest('.drink-card');
        const qtySpan = card.querySelector('.qty');
        let qty = parseInt(qtySpan.textContent) + delta;
        if (qty < 0) qty = 0;
        qtySpan.textContent = qty;
        updateTotal();
    }

    function updateTotal() {
        const cards = document.querySelectorAll('.drink-card');
        let total = 0;
        let itemCount = 0;

        cards.forEach(card => {
            const qty = parseInt(card.querySelector('.qty').textContent);
            const price = parseFloat(card.dataset.price);
            total += qty * price;
            itemCount += qty;
        });

        document.getElementById('order-total').textContent = '$' + total.toFixed(2);
        document.getElementById('order-items').textContent = itemCount;
    }

    function clearCart() {
        document.querySelectorAll('.qty').forEach(span => span.textContent = '0');
        updateTotal();
    }
</script>

