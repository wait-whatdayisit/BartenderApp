@{
    ViewData["Title"] = "Bartender Dashboard";
}

<div class="text-center">
    <h1 class="display-4">Bartender Dashboard</h1>
</div>

<div style="display: flex; justify-content: space-evenly; align-items: center; padding: 40px;">
    <div style="width: 300px; height: 450px; border: 2px solid steelblue; border-radius: 16px; display: flex; flex-direction: column; align-items: center; justify-content: space-evenly; padding: 20px;">
        <img src="https://placehold.co/240x160" alt="placeholder" style="border-radius: 8px; width: 100%;">
        <p style="text-align: center; font-family: sans-serif;">View menu and place an order for drinks.</p>
        <a asp-controller="Order" asp-action="Index" 
           style="padding: 10px 24px; border: 2px solid steelblue; border-radius: 8px; 
          color: steelblue; font-size: 14px; cursor: pointer; text-decoration: none; 
          display: inline-flex; align-items: center; gap: 6px;">
            <i class="bi bi-cup-straw"></i>
            Place Order
        </a>
    </div>

    <div style="width: 300px; height: 450px; border: 2px solid steelblue; border-radius: 16px; display: flex; flex-direction: column; align-items: center; justify-content: space-evenly; padding: 20px;">
        <img src="https://placehold.co/240x160" alt="placeholder" style="border-radius: 8px; width: 100%;">
        <p style="text-align: center; font-family: sans-serif;">View the drink orders that have already been placed.</p>
        <a asp-controller="Order" asp-action="Queue" 
           style="padding: 10px 24px; border: 2px solid steelblue; border-radius: 8px; 
          color: steelblue; font-size: 14px; cursor: pointer; text-decoration: none; 
          display: inline-flex; align-items: center; gap: 6px;">
            <i class="bi bi-list-ol"></i>
            View Orders
        </a>
    </div>
</div>